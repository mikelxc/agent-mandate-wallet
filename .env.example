# No private keys are used by the frontend. Never put secrets in public environment variables.
# Public-chain deployment is intentionally a separate, explicit setup step.
# Passkey onboarding is disabled unless both values are set in the gateway environment.
# MANDATE_PASSKEY_FACTORY=0x...
# MANDATE_PASSKEY_RELAYER_KEY=0x...  # gateway secret; never expose to the frontend

# Vercel gateway storage: connect Turso Starter through Vercel Storage.
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=...  # server-only secret
# MANDATE_DASHBOARD_ORIGINS=https://wayleave.xyz,https://www.wayleave.xyz

# Optional external gateway override: HTTPS origin without a trailing slash.
# Leave unset when the gateway runs in the same Vercel project; see docs/vercel.md.
# MANDATE_GATEWAY_ORIGIN=https://gateway.example.com

# First merchant: Wayleave Developer Pack. Server-side only; no recipient is assumed.
# WAYLEAVE_MERCHANT_RECIPIENT=0x... # your receiving wallet on Ethereum Sepolia
# WAYLEAVE_PACK_PRICE_UNITS=100000 # minimum merchant receipt: 0.10 test USDC
# WAYLEAVE_PACK_MAX_FEE_UNITS=1000 # source debit = price + this fee budget; gas extra
# Unused transfer fee budget reaches the merchant. No refunds or exact-net quote support.

# Optional additional Arc history provider. Keep existing WAYLEAVE_GRAPH_* for Sepolia.
# WAYLEAVE_ARC_GRAPH_ENDPOINT=https://api.studio.thegraph.com/query/1760154/wayleave/arc-testnet-v0.1.0
# WAYLEAVE_ARC_GRAPH_DEPLOYMENT=QmZ9UkFJzAsWsWmwyWpQQApXP1XQbkaSwCazSMrFEvs2LN
# WAYLEAVE_ARC_GRAPH_CHAIN_ID=5042002
# WAYLEAVE_ARC_GRAPH_START_BLOCK=61600603
# WAYLEAVE_ARC_GRAPH_TOKEN=0x3600000000000000000000000000000000000000
# WAYLEAVE_ARC_GRAPH_API_KEY=... # optional query key, never the Studio deploy key
