{
  "name": "wayleave-mcp",
  "version": "0.1.2",
  "description": "Scoped MCP tools for Wayleave agent accounts",
  "bin": {
    "wayleave-mcp": "./dist/cli.js"
  },
  "type": "module",
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/server.ts --target=node --outfile=dist/cli.js --production --reject-unresolved",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@mandate/protocol": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/bun": "latest",
    "typescript": "5.9.3",
    "zod": "4.5.4",
    "@mandate/sdk": "workspace:*",
    "viem": "2.56.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wayleave",
    "agent"
  ],
  "license": "MIT",
  "homepage": "https://www.wayleave.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikelxc/agent-mandate-wallet.git",
    "directory": "packages/agent-tools"
  },
  "bugs": {
    "url": "https://github.com/mikelxc/agent-mandate-wallet/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
