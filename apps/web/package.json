{
  "name": "@mandate/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "bun --bun next dev --hostname 127.0.0.1",
    "dev:e2e": "NODE_ENV=development NEXT_PUBLIC_MANDATE_DEV_WALLET=true MANDATE_DEV_WALLET=true bun dev-server.ts",
    "e2e:sepolia": "MANDATE_RUN_SEPOLIA_E2E=true playwright test",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "e2e:ui": "bun --bun playwright test tests/workspace-ui.spec.ts tests/onboarding-ui.spec.ts tests/owner-auth.spec.ts"
  },
  "dependencies": {
    "@base-org/account": "2.4.0",
    "@base-ui/react": "1.7.0",
    "@libsql/client": "0.18.0",
    "@mandate/gateway": "workspace:*",
    "@mandate/protocol": "workspace:*",
    "@mandate/sdk": "workspace:*",
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-wagmi": "^1.8.23",
    "@reown/appkit-controllers": "1.8.23",
    "@reown/appkit-siwe": "1.8.23",
    "@shadcn/react": "0.3.0",
    "@tanstack/react-query": "latest",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "viem": "latest",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
